DISCORD_BOT_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the HTTPS URI registered in TikTok Login Kit.
TIKTOK_REDIRECT_URI=https://your-domain.example/oauth/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=bot.sqlite3
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Optional: set to your test server ID for immediate slash-command sync.
DISCORD_GUILD_ID=
MAX_VIDEO_MB=100
# Optional YouTube Shorts integration. Set all three to enable /link-youtube and posting panels.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Example redirect: https://your-domain.example/oauth/youtube/callback
# Optional ffprobe executable path; defaults to ffprobe on PATH. Railway installs it automatically.
FFPROBE_PATH=ffprobe
